# Dependencies (this repo is deliberately dependency-free; see CONTRIBUTING.md)
node_modules/
.pnpm-store/

# ---------------------------------------------------------------------------
# Secrets — never commit any of these. This repo configures zero secrets, and
# that is a product claim, not a preference. See docs/method.md § P0.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.credentials.yaml
.credentials.yml
credentials.json
*.pem
*.key
*.p12
.netrc

# Local DSH state (profiles, sessions, credentials)
.dsh/
profiles/desktop/

# ---------------------------------------------------------------------------
# Verification scratch space. Published evidence lives inside catalog/*.json
# (the report's `evidence` array), so nothing here needs re-including.
# ---------------------------------------------------------------------------
.verify/
tmp/
scratch/
*.log
*.tgz
*.tar.gz

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
