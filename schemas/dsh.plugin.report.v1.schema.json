{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/citrusli2026/dsh-verified-plugins/schemas/dsh.plugin.report.v1.schema.json",
  "title": "dsh.plugin.report.v1",
  "description": "Execution-verified report about one exact DeepSeek Harness plugin version. A verdict names the highest dimension set that actually executed; it is capped by the evidence present. See docs/method.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reportId",
    "generatedAt",
    "verifier",
    "subject",
    "runtime",
    "verdict",
    "dimensions",
    "evidence",
    "disclaimers"
  ],
  "properties": {
    "schema": { "const": "dsh.plugin.report.v1" },
    "reportId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/@-]*$",
      "description": "Stable identity, conventionally 'npm:<name>@<version>'."
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}",
      "description": "When the verification ran, ISO 8601 UTC."
    },
    "supersedes": {
      "type": "string",
      "description": "reportId of the report this one replaces, when a version was re-verified."
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full verifier commit SHA. Short SHAs are not published."
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "name", "version"],
      "properties": {
        "spec": { "type": "string" },
        "name": { "type": "string" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+",
          "description": "Exact resolved version. Never a range, tag or branch."
        },
        "registry": { "type": "string" },
        "tarball": { "type": "string" },
        "integrity": {
          "type": "string",
          "pattern": "^sha(256|384|512)-[A-Za-z0-9+/=]+$",
          "description": "Integrity hash actually resolved, not the one the registry advertises."
        },
        "shasum": { "type": "string" },
        "repository": { "type": "string" },
        "license": { "type": "string" },
        "publishedAt": { "type": "string" },
        "dshBundlePatch": {
          "type": ["string", "array"],
          "description": "Declared dsh.bundle.patch, quoted from package.json."
        },
        "declaredEnginesDsh": {
          "type": "string",
          "description": "Author-declared engines.dsh. Declarative only: installers and loaders do not enforce it."
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dshVersion", "nodeVersion"],
      "properties": {
        "dshVersion": { "type": "string" },
        "nodeVersion": { "type": "string" },
        "os": { "type": "string" },
        "arch": { "type": "string" }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": { "type": "string" },
        "imageDigest": {
          "type": ["string", "null"],
          "description": "sha256 digest when the image is published. null means the image is unaddressed by digest and the report is not fully reproducible."
        },
        "dockerfileCommit": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "bundlePatch": {
      "type": "object",
      "description": "Analysis of the declared cordis.patch.yml. A DSH bundle patch can disable host entries, rewrite their configuration, and carry `!!js` expressions, none of which a lib/** scan can see.",
      "additionalProperties": false,
      "required": ["path", "present"],
      "properties": {
        "path": { "type": "string" },
        "present": { "type": "boolean" },
        "bytes": { "type": "integer", "minimum": 0 },
        "entryCount": { "type": "integer", "minimum": 0 },
        "disablesHostEntries": { "type": "boolean" },
        "overridesConfig": { "type": "boolean" },
        "usesJsExpressions": { "type": "boolean" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "line", "snippet"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["disables-entry", "overrides-config", "js-expression", "inserts-entry"]
              },
              "line": { "type": "integer", "minimum": 1 },
              "snippet": { "type": "string" }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["verified", "partial", "inconclusive", "not-installable"]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "L0_qualification",
        "L1_install",
        "L2_load",
        "L3_run",
        "L4_capability",
        "L5_overhead",
        "L6_uninstall"
      ],
      "properties": {
        "L0_qualification": { "$ref": "#/$defs/dimension" },
        "L1_install": { "$ref": "#/$defs/dimension" },
        "L2_load": { "$ref": "#/$defs/dimension" },
        "L3_run": { "$ref": "#/$defs/dimension" },
        "L4_capability": { "$ref": "#/$defs/dimension" },
        "L5_overhead": { "$ref": "#/$defs/dimension" },
        "L6_uninstall": { "$ref": "#/$defs/dimension" }
      }
    },
    "capabilities": {
      "type": "array",
      "description": "L4 capability findings. Capability is not intent: presence is reported, never characterised as malicious.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "present", "confidence", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "runtime_patch",
              "spawns_process",
              "listens_on_port",
              "reads_secret_env",
              "hooks_system_prompt",
              "hooks_api_gate",
              "writes_outside_workspace",
              "watches_filesystem",
              "network_egress",
              "eval_or_dynamic_code"
            ]
          },
          "present": { "type": "boolean" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "attribution": {
            "type": "string",
            "enum": ["author-source", "build-output", "dependency", "unknown"],
            "description": "Whether the code is author-written, bundler output, or a vendored dependency. Misattributing build output to the author is a known failure mode of this class of tool."
          },
          "notes": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file"],
              "properties": {
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "snippet": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "overhead": {
      "type": "object",
      "additionalProperties": true,
      "required": ["method", "status"],
      "properties": {
        "method": { "const": "differential" },
        "status": {
          "type": "string",
          "enum": ["measured", "no-significant-delta", "inconclusive", "timeout"]
        },
        "samples": { "type": "integer", "minimum": 1 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "Every conclusion in the report maps to an entry here.",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "redactions": {
      "type": "array",
      "description": "Disclosed removals. A redacted value appears in evidence as [redacted:<reason>].",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": {
          "reason": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "disclaimers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "limits": {
      "type": "array",
      "description": "What this run could not establish, stated explicitly rather than left implicit.",
      "items": { "type": "string" }
    },
    "changelog": {
      "type": "array",
      "description": "Corrections are additive: a wrong finding is superseded, never quietly edited.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "change"],
        "properties": {
          "date": { "type": "string" },
          "change": { "type": "string" },
          "supersedesVerdict": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^L[0-6]$" },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "skip", "blocked", "inconclusive", "timeout"]
        },
        "summary": { "type": "string" },
        "metrics": { "type": "object" },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["command", "log", "sample", "static", "artifact"] },
        "command": { "type": "string" },
        "exitCode": { "type": "integer" },
        "durationMs": { "type": "number", "minimum": 0 },
        "excerpt": {
          "type": "string",
          "description": "Redacted excerpt, at most 2 KiB. Never a full command output dump."
        },
        "excerptBytes": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
